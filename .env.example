# GEMINI_API_KEY: Obrigatória para as chamadas de IA do Bililiu via @google/genai
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde a aplicação está hospedada (injetada automaticamente ou configurada na Vercel)
APP_URL="MY_APP_URL"

# DATABASE_URL: String de conexão do Neon PostgreSQL (Opcional - a aplicação roda 100% in-memory se vazio para economia extrema)
DATABASE_URL="postgres://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# PORT: Porta do servidor Express (Padrão: 3000)
PORT=3000
